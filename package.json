{
  "name": "elite-accessories",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/prepare-cloudflare.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/logic.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.json *.ts index.html README.md",
    "build:cloudflare": "npm run build",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.78.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.156.2"
  }
}
